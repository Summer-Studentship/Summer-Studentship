{
  "schema": {
    "name": "tsunami.openfoam_replay_configuration",
    "version": "1.1.0"
  },
  "section_id": "boundary.offshore",
  "openfoam_patch": "inlet",
  "boundary_policy": {
    "mode": "open_ocean_damped",
    "outlet": "open_ocean",
    "laterals": "open_ocean",
    "atmosphere": "open_atmosphere",
    "policy_version": "1.0.0"
  },
  "damping_policy": {
    "enabled": true,
    "model": "isotropicDamping",
    "profile": "halfCosineRamp",
    "outlet_width_fraction": 0.15,
    "lateral_width_fraction": 0.10,
    "target_e_folds": 4.0
  },
  "wall_function_policy": {
    "mode": "continuous_spalding",
    "k": "kqRWallFunction",
    "omega": "omegaWallFunction",
    "nut": "nutUSpaldingWallFunction"
  },
  "timestep_policy": {
    "adjust_time_step": true,
    "target_max_co": 0.25,
    "target_max_alpha_co": 0.25,
    "minimum_timestep_s": 1.0e-7
  },
  "regional": {
    "dry_depth_m": 1.0e-6,
    "eta_consistency_tolerance_m": 1.0e-8,
    "inward_normal_xy": [1.0, 0.0],
    "tangent_xy": [0.0, 1.0],
    "vertical_datum_origin_m": 0.0
  },
  "local": {
    "inward_axis": [1.0, 0.0, 0.0],
    "span_axis": [0.0, 1.0, 0.0],
    "vertical_axis": [0.0, 0.0, 1.0],
    "origin_m": [0.0, 0.0, 0.0],
    "span_min_m": 0.0,
    "span_max_m": 0.6,
    "vertical_min_m": 0.0,
    "vertical_max_m": 0.6,
    "span_cells": 6,
    "vertical_cells": 12
  },
  "mapping": {
    "spatial_interpolation": "piecewise_linear_along_section",
    "outside_span": "clamp",
    "velocity_profile": "depth_uniform",
    "vertical_velocity_m_per_s": 0.0,
    "preserve_discrete_discharge": true
  },
  "turbulence": {
    "intensity": 0.05,
    "length_scale_m": 0.05,
    "minimum_speed_m_per_s": 0.01
  },
  "local_case": {
    "streamwise_length_m": 2.0,
    "streamwise_cells": 40,
    "span_cells": 60,
    "vertical_cells": 12,
    "end_time_s": 0.12,
    "maximum_timestep_s": 0.02,
    "initial_timestep_s": 0.001,
    "write_interval_s": 0.04,
    "initial_water_level_m": 0.18,
    "alpha_tolerance": 5.0e-5
  },
  "barrier": {
    "streamwise_position_m": 0.9,
    "thickness_m": 0.06,
    "height_m": 0.24,
    "span_fraction": 1.0
  }
}
